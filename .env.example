APP_SECRET_KEY=replace-with-a-random-secret
SHARED_PASSWORD=replace-with-a-lab-demo-password

# Required by the API for Slack Events and workspace installation.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=https://your-public-host/slack/oauth/callback

# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this stable: changing it makes stored Slack/Zotero credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# Temporary pre-OAuth migration bridge only. Remove all three values after the
# existing test workspace passes OAuth event + worker smoke verification.
SLACK_OAUTH_MIGRATION_MODE=false
SLACK_LEGACY_TEAM_ID=
SLACK_BOT_TOKEN=

# Optional worker tuning.
WORKER_INTERVAL_SECONDS=60
BACKFILL_LIMIT_PER_CHANNEL=200
ARXIV_REQUEST_DELAY_SECONDS=3

# Optional default used when /status verifies and saves the Trial Zotero Destination.
# The group ID and API key are entered through authenticated /status, not .env.
ZOTERO_API_BASE_URL=https://api.zotero.org
ZOTERO_SYNC_LIMIT=20

# Optional external related-paper suggestions.
RELATED_PAPERS_ENABLED=false
RELATED_PAPERS_LIMIT=5
SEMANTIC_SCHOLAR_API_KEY=
